<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family: Outfit has no
     glyphs for most Vietnamese accented letters, so values-vi points them at the system sans-serif (#833). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/outfit</string>
    <string name="font_regular" translatable="false">@font/outfit_regular</string>
    <string name="font_light" translatable="false">@font/outfit_light</string>
    <string name="font_extralight" translatable="false">@font/outfit_extralight</string>
    <string name="font_medium" translatable="false">@font/outfit_medium</string>
    <!-- The names and the year count on Jahreskreis' personal days (PersonalMotions). -->
    <string name="font_bold" translatable="false">@font/outfit_bold</string>
    <!-- The worlds' fonts (WorldTypography), static Latin instances cut from the variable upstream files:
         Cormorant Garamond for Hogwarts, Oswald for Marvel, Michroma for Star Wars. -->
    <string name="font_world_hog_light" translatable="false">@font/cormorant_garamond_light</string>
    <string name="font_world_hog_regular" translatable="false">@font/cormorant_garamond_regular</string>
    <string name="font_world_hog_italic" translatable="false">@font/cormorant_garamond_italic</string>
    <string name="font_world_marvel_light" translatable="false">@font/oswald_light</string>
    <string name="font_world_marvel_medium" translatable="false">@font/oswald_medium</string>
    <string name="font_world_marvel_bold" translatable="false">@font/oswald_bold</string>
    <string name="font_world_starwars" translatable="false">@font/michroma</string>
</resources>
