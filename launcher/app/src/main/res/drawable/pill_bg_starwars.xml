<?xml version="1.0" encoding="utf-8"?>
<!-- Star Wars' top pills (spec § 4.4): square holo switches, 3dp corners, rim #8FB3FF at 70 % inside a blue outer
     glow. The glow is part of the pill's 42dp, as a background cannot draw outside its view. Focused, the switch
     fills with the holo blue so pill_text's dark icon stands out, as on Clean's white pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#665B8CFF" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F2CFE0FF" />
                    <stroke android:width="1dp" android:color="#FFFFFFFF" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#2E5B8CFF" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#595B8CFF" />
                    <stroke android:width="1.5dp" android:color="#FFCFE0FF" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#2E5B8CFF" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#800A1432" />
                    <stroke android:width="1dp" android:color="#B38FB3FF" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <!-- The inner glow: a faint band just inside the rim. -->
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#1F5B8CFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
