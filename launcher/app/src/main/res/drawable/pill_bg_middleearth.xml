<?xml version="1.0" encoding="utf-8"?>
<!-- Middle-earth's top pills (Mittelerde spec § 4.3): round, a thin gold rim (#D9B56A) round a dark fill (#0C0D0B at
     65 %, the world's background). Focused, the pill fills with the gold so pill_text's dark icon stands out, as on
     Clean's white pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F2D9B56A" />
            <stroke android:width="1dp" android:color="#FFF3E2B8" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#59D9B56A" />
            <stroke android:width="1.5dp" android:color="#FFD9B56A" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A60C0D0B" />
            <stroke android:width="1dp" android:color="#FFD9B56A" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
