<?xml version="1.0" encoding="utf-8"?>
<!-- Supernatural's top pills (spec § 4.3): square plates, 2dp corners, a brass rim (amber #E0A24A at 70 % with a faint
     inner line, as worn brass) round a dark fill (#140F0A at 60 %, the mockup's). Focused, the plate fills with the
     amber so pill_text's dark icon stands out, as on Clean's white pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#F2E0A24A" />
                    <stroke android:width="1.5dp" android:color="#FFF2E6CF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#59E0A24A" />
                    <stroke android:width="1.5dp" android:color="#FFE0A24A" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#99140F0A" />
                    <stroke android:width="1.5dp" android:color="#B3E0A24A" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <!-- The brass's inner line: a thin, faint band just inside the rim. -->
            <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#33E0A24A" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
