<?xml version="1.0" encoding="utf-8"?>
<!-- Seasons (SeasonsActivity, Jahreskreis spec § 4.7): Add an entry on top, then the personal days (made in code under
     dayList), the anniversary crawl text, the anniversary greeting and the Mother's Day and Father's Day switches. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/world_seasons"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/seasons_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/addChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/seasons_add" />

        <LinearLayout
            android:id="@+id/dayList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/crawlChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/seasons_crawl" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/seasons_crawl_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/anniversaryGreetingChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/seasons_anniversary_greeting" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/seasons_anniversary_greeting_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/mothersDayChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/fathersDayChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</ScrollView>
